# Get a key at https://resend.com/api-keys
RESEND_API_KEY=

# Where contact form submissions get emailed to
CONTACT_TO_EMAIL=you@example.com

# Must be a verified sending domain in Resend, e.g. "Caitlyn <hello@callcaitlyn.com>".
# For local testing before you've verified a domain, Resend lets you send
# from onboarding@resend.dev to the email address on your own Resend account only.
CONTACT_FROM_EMAIL=onboarding@resend.dev

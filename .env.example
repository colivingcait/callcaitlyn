# Supabase project settings (Project Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The email you'll use to log in (must match the user you create in Supabase Auth)
NEXT_PUBLIC_APP_NAME="CallCaitlyn CRM"

# Quo (formerly OpenPhone) call/text sync - see README's Quo section
# Your Supabase user ID (Authentication -> Users -> copy the UID column)
CRM_OWNER_USER_ID=
# Project Settings -> API -> service_role key. SERVER-ONLY SECRET - never
# expose this to the browser or prefix it NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Quo dashboard -> Settings -> API
QUO_API_KEY=
# Returned when you create the webhook via the Quo API - see README
QUO_WEBHOOK_SIGNING_KEY=
# Set to "true" once QUO_WEBHOOK_SIGNING_KEY is confirmed working, to start
# rejecting unsigned/invalid webhook requests. Leave unset while testing.
# CRM_QUO_ENFORCE_SIGNATURE=true

# Calendly booking sync - see README's Calendly section
# Personal Access Token (Calendly -> Integrations -> API & Webhooks), used
# once to register the webhook subscription
CALENDLY_API_TOKEN=
# Returned when you create the webhook subscription via the Calendly API
CALENDLY_WEBHOOK_SIGNING_KEY=
# Same idea as CRM_QUO_ENFORCE_SIGNATURE - leave unset while testing
# CRM_CALENDLY_ENFORCE_SIGNATURE=true

# Eventbrite registration sync - see README's Eventbrite section
# Account Settings -> Developer Links -> API Keys -> Private Token. Used at
# runtime to fetch attendee details (Eventbrite webhooks only send a link,
# not the data itself).
EVENTBRITE_API_TOKEN=
# Any random string you choose - baked into the webhook URL as ?secret=...
# since Eventbrite doesn't offer webhook signature verification. Must match
# exactly what you put in the URL when creating the webhook.
EVENTBRITE_WEBHOOK_SECRET=

# Jotform in-person check-in sync - see README's Jotform section
# Any random string you choose - same idea as EVENTBRITE_WEBHOOK_SECRET,
# baked into the webhook URL since Jotform doesn't sign requests either.
JOTFORM_WEBHOOK_SECRET=

# AI insights - see README's AI insights section
# console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=

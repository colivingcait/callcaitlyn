# Supabase project settings (Project Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The email you'll use to log in (must match the user you create in Supabase Auth)
NEXT_PUBLIC_APP_NAME="CallCaitlyn CRM"

# Quo (formerly OpenPhone) call/text sync - see README's Quo section
# Your Supabase user ID (Authentication -> Users -> copy the UID column)
CRM_OWNER_USER_ID=
# Project Settings -> API -> service_role key. SERVER-ONLY SECRET - never
# expose this to the browser or prefix it NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Quo dashboard -> Settings -> API
QUO_API_KEY=
# Returned when you create the webhook via the Quo API - see README
QUO_WEBHOOK_SIGNING_KEY=
# Set to "true" once QUO_WEBHOOK_SIGNING_KEY is confirmed working, to start
# rejecting unsigned/invalid webhook requests. Leave unset while testing.
# CRM_QUO_ENFORCE_SIGNATURE=true

# Calendly booking sync - see README's Calendly section
# Personal Access Token (Calendly -> Integrations -> API & Webhooks), used
# once to register the webhook subscription
CALENDLY_API_TOKEN=
# Returned when you create the webhook subscription via the Calendly API
CALENDLY_WEBHOOK_SIGNING_KEY=
# Same idea as CRM_QUO_ENFORCE_SIGNATURE - leave unset while testing
# CRM_CALENDLY_ENFORCE_SIGNATURE=true

# Eventbrite registration sync - see README's Eventbrite section
# Account Settings -> Developer Links -> API Keys -> Private Token. Used at
# runtime to fetch attendee details (Eventbrite webhooks only send a link,
# not the data itself).
EVENTBRITE_API_TOKEN=
# Any random string you choose - baked into the webhook URL as ?secret=...
# since Eventbrite doesn't offer webhook signature verification. Must match
# exactly what you put in the URL when creating the webhook.
EVENTBRITE_WEBHOOK_SECRET=
# Optional - only needed if you run Women's REI meetups through a SEPARATE
# Eventbrite account. Same idea as EVENTBRITE_API_TOKEN but for that
# account's own Private Token. Its webhook subscription (registered in
# THAT account's own Account Settings -> Webhooks) uses the same secret
# above plus &account=womens_rei on the URL - see README. Leave unset if
# everything runs through one Eventbrite account.
EVENTBRITE_WOMENS_REI_API_TOKEN=

# Jotform in-person check-in sync - see README's Jotform section
# Any random string you choose - same idea as EVENTBRITE_WEBHOOK_SECRET,
# baked into the webhook URL since Jotform doesn't sign requests either.
JOTFORM_WEBHOOK_SECRET=
# Optional - only needed if you have more than one kiosk form (e.g. one
# for House Hacking meetups, one for Women's REI meetups). Both forms
# point at the SAME webhook URL/secret above; these map each form's ID to
# the right event name/tag so one endpoint can tell them apart. Find a
# form's ID in its Jotform URL (form.jotform.com/{THIS_NUMBER}) or under
# Settings -> Integrations -> Webhooks. Leave both unset if you only have
# one check-in form - everything still works, just with a generic
# "In-person meetup" label instead of a specific one.
JOTFORM_HOUSE_HACKING_FORM_ID=
JOTFORM_WOMENS_REI_FORM_ID=

# Tactiq meeting transcripts, delivered via Zapier - see README's Tactiq
# section. Any random string you choose - baked into the webhook URL as
# ?secret=... the same way EVENTBRITE_WEBHOOK_SECRET is, since a Zapier
# "Webhooks by Zapier" POST doesn't forward Tactiq's own signing headers.
TACTIQ_WEBHOOK_SECRET=

# House Hacking site (househackingatl.com) signups - see README's House
# Hacking site section. Comma-separated list of origins allowed to POST to
# /api/webhooks/house-hacking-site (only affects the browser's CORS
# preflight, not a real access control - leave unset to use the default of
# the site's own www/apex domains).
# HOUSE_HACKING_SITE_ORIGINS=https://www.househackingatl.com,https://househackingatl.com

# AI insights - see README's AI insights section
# console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=

# Gmail sync, sending, and sequences - see README's Gmail section
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match a redirect URI registered on that OAuth client - this
# is the CRM's own domain (crm.callcaitlyn.com), NOT the public marketing
# site (callcaitlyn.com) - they're two separate Vercel projects, and
# Google redirecting to the wrong one 404s since that route only exists
# on the CRM deployment.
GOOGLE_REDIRECT_URI=https://crm.callcaitlyn.com/api/auth/gmail/callback
# Used to build tracking-pixel/click-redirect/unsubscribe links in sequence
# emails - same crm.callcaitlyn.com domain as above, not the marketing site.
APP_BASE_URL=https://crm.callcaitlyn.com
# Any random string you choose - authenticates Vercel Cron's calls to
# /api/cron/*. Vercel sets this automatically as a project env var when you
# add a cron job, but confirm it's actually set after deploying.
CRON_SECRET=

# Push notifications (new-lead alerts) - generate once with
# `npx web-push generate-vapid-keys` and never regenerate afterward, or
# every device that already enabled notifications will need to re-enable.
# The public key is exposed to the browser on purpose (that's how Web Push
# works); the private key is server-only, never expose it.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Any mailto: address - required by the Web Push spec so a push service can
# contact you if it needs to (e.g. Chrome flags your key as sending too much).
VAPID_SUBJECT=mailto:you@example.com
